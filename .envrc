# direnv: project accounts for this repo (allowed per worktree by scripts/orca-setup.sh).
export CLOUDSDK_ACTIVE_CONFIG_NAME=follow-the-fake
# Plain `gh` acts as visionary-sender here; only set when that login has a token.
if t="$(gh auth token -u visionary-sender 2>/dev/null)" && [ -n "$t" ]; then export GH_TOKEN="$t"; fi
unset t
