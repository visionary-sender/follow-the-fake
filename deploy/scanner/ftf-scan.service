# Follow the Fake ad-library scan, one capped run. Installed on the sandbox VM by
# scripts/scanner-sandbox.sh. Runs as the unprivileged user ftf-scanner; never fetches landing pages.
[Unit]
Description=Follow the Fake ad-library scan
Wants=network-online.target
After=network-online.target
# Search terms are private: the file is copied to the sandbox from the workbench (scripts/scanner-sandbox.sh
# keywords). Until it exists the run is skipped, not failed.
ConditionPathExists=/opt/ftf-scanner/config/scanner-keywords.txt

[Service]
Type=oneshot
User=ftf-scanner
Group=ftf-scanner
UMask=0027
WorkingDirectory=/opt/ftf-scanner/home
Environment=HOME=/opt/ftf-scanner/home XDG_CACHE_HOME=/opt/ftf-scanner/home/.cache XDG_CONFIG_HOME=/opt/ftf-scanner/home/.config
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ftf-scanner/ms-playwright LANG=C.UTF-8
EnvironmentFile=-/opt/ftf-scanner/scan.env
ExecStart=/opt/ftf-scanner/venv/bin/ftf scan --out /opt/ftf-scanner/data --download-creatives --keywords-file /opt/ftf-scanner/config/scanner-keywords.txt $FTF_SCAN_ARGS
StandardOutput=append:/opt/ftf-scanner/log/scan.log
StandardError=append:/opt/ftf-scanner/log/scan.log
# 75 = another scan still holds the lock: skipped, not failed.
SuccessExitStatus=75
TimeoutStartSec=90min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ftf-scanner/data /opt/ftf-scanner/home /opt/ftf-scanner/log
