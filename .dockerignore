# Default deny: the build context contains only what the image build needs.
# Data, captures, git metadata and assistant files never reach the daemon.
*
!pyproject.toml
!README.md
!src/
!docker/entrypoint.sh
!docker/brand-stoplist/
docker/brand-stoplist/*
!docker/brand-stoplist/brand-stoplist.json
!docker/brand-stoplist/.gitkeep

# Bytecode and build leftovers inside the copied source tree.
**/__pycache__
**/*.pyc
**/*.egg-info
**/.DS_Store

# Baked face reference set (filled on the workbench VM; the folder itself is kept, see the Dockerfile).
!docker/build-context/faces-reference/
!docker/build-context/faces-reference/**
